name: Solar-Powered CI
on: [push]

jobs:
  check-grid-intensity:
    runs-on: ubuntu-latest
    outputs:
      should_run: ${{ steps.check.outputs.run_heavy_test }}
    steps:
      - id: check
        run: |
          # Fetch real-time solar/carbon data for your runner's region
          INTENSITY=$(curl -s https://api.watttime.org/v2/index?latitude=...&longitude=...)
          if [[ "$INTENSITY" -lt 50 ]]; then
            echo "run_heavy_test=true" >> $GITHUB_OUTPUT
          else
            echo "Grid is high-carbon. Delaying non-critical jobs."
            echo "run_heavy_test=false" >> $GITHUB_OUTPUT
          fi

  high_energy_tests:
    needs: check-grid-intensity
    if: needs.check-grid-intensity.outputs.should_run == 'true'
    runs-on: high-perf-runner
    steps:
      - name: Run Intensive Bitcoin Tests
        run: ./build/bin/test_bitcoin --run_test=getarg_tests/doubledash
